# Copy to .env and adjust. Never commit .env (it may contain the API key).
MCP_PORT=8080

# Upstream What's Building site (public endpoints only, anonymous).
WHATSBUILDING_BASE_URL=https://www.nanaimo.ca/whatsbuilding/
WHATSBUILDING_CACHE_MINUTES=30
WHATSBUILDING_HTTP_TIMEOUT_SECONDS=60
WHATSBUILDING_USER_AGENT=WhatsBuildingMcp/1.0 (+https://www.nanaimo.ca/whatsbuilding/)
WHATSBUILDING_DETAIL_CACHE_MINUTES=15

# Optional bearer token for the MCP endpoint itself. Empty = open endpoint.
MCP_API_KEY=

# Optional CORS origins for browser-based MCP clients (empty = CORS disabled).
MCP_ALLOWED_ORIGIN_0=
MCP_ALLOWED_ORIGIN_1=

# Inbound rate limit for the MCP endpoint.
RATELIMIT_PERMIT_LIMIT=60
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_QUEUE_LIMIT=10
